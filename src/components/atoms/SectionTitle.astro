---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<h2
	class='titles-lg text-primary-100 sticky top-0 z-10 w-full py-6 font-bold tracking-wider uppercase lg:sr-only'
>
	<div
		class="class='bg-primary-10/20 transition-colors' absolute top-0 left-[calc(50%-50vw)] -z-10 h-full w-screen backdrop-blur-xs"
	>
	</div>

	{title}
</h2>
