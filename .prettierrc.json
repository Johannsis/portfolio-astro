{
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"jsxSingleQuote": true,
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"arrowParens": "always",
				"bracketSpacing": true,
				"endOfLine": "lf",
				"jsxSingleQuote": true,
				"parser": "astro",
				"printWidth": 80,
				"quoteProps": "as-needed",
				"semi": true,
				"singleQuote": true,
				"tabWidth": 2,
				"trailingComma": "all",
				"useTabs": true
			}
		}
	],
	"parser": "astro",
	"plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
	"printWidth": 80,
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": true,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true
}
