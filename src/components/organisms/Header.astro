---
import type { SocialLink } from '../../data/user';
import ContactLinks from '../molecules/ContactLinks.astro';
import HeaderSections from '../molecules/HeaderSections.astro';

interface Props {
	job: string;
	location: string;
	motto: string;
	name: string;
	pageSections: readonly string[];
	socialLinks: SocialLink[];
}

const { job, location, motto, name, pageSections, socialLinks } = Astro.props;
---

<header
	class='mb-20 flex flex-col gap-6 min-h-60 lg:mb-0 2xl:max-w-[calc(20%-0.75rem)] lg:max-w-[33%] lg:min-h-[90dvh] lg:justify-between lg:fixed lg:max-h-dvh'
>
	<div class='flex flex-col gap-4 w-full'>
		<h1
			class='title-gradient titles-4xl leading-tight tracking-tight font-800 lg:leading-12'
		>
			{name}
		</h1>
		<p class='text-primary-100 titles-xl tracking-tight font-700'>{job}</p>
		<p class='body-sm text-primary-80 font-500'>Based in {location}</p>
		<p class='body-sm text-primary-80 mt-2 max-w-xs'>{motto}</p>
	</div>

	<HeaderSections pageSections={pageSections} />

	<ContactLinks socialLinks={socialLinks} />
</header>
