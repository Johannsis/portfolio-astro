---
interface Props {
  ariaLabel?: string;
  className?: string;
  id?: string;
}

const { ariaLabel, className = "", id } = Astro.props;
---

<section aria-label={ariaLabel} class={`section ${className}`.trim()} id={id}>
  <slot />
</section>

<style>
  .section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
</style>
