---
interface Props {
	currentYear: number;
}

const { currentYear } = Astro.props;
---

<footer class='site-footer text-primary-100'>
	<div class='site-footer-inner'>
		<p class='body-xs site-footer-credit'>
			Designed with <span aria-hidden='true'>💚</span> in <span
				class='text-primary-100 font-600'
			>
				Next.js
			</span> and <span class='text-primary-100 font-600'>Tailwind CSS</span>,
			deployed in GitHub Pages.
		</p>
		<p class='body-xs text-primary-80 site-footer-copy'>
			© {currentYear} Johannes Hoersch
		</p>
	</div>
</footer>

<style>
	.site-footer {
		z-index: 10;
		width: 100%;
		margin-top: 3rem;
	}

	.site-footer-inner {
		display: flex;
		width: 100%;
		max-width: 80rem;
		flex-direction: column;
		padding-top: 2.5rem;
		padding-bottom: 2.5rem;
		border-top: 1px solid oklch(0.24 0.02 200deg / 15%);
		gap: 0.75rem;
	}

	.site-footer-credit {
		font-weight: 400;
		line-height: 1.625;
	}

	.site-footer-copy {
		font-weight: 400;
		line-height: 1.625;
	}

	@media (width >= 1024px) {
		.site-footer-inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding-top: 3rem;
			padding-bottom: 3rem;
		}
	}
</style>
