{
	"arrowParens": "always",
	"bracketSpacing": true,
	"endOfLine": "lf",
	"ignorePatterns": ["dist", "**/node_modules", "node_modules", "bun.lock"],
	"insertFinalNewline": true,
	"jsxSingleQuote": true,
	"overrides": [
		{
			"files": "*.astro",
			"options": {
				"arrowParens": "always",
				"bracketSpacing": true,
				"endOfLine": "lf",
				"jsxSingleQuote": true,
				"parser": "astro",
				"printWidth": 80,
				"quoteProps": "as-needed",
				"semi": true,
				"singleQuote": true,
				"tabWidth": 2,
				"trailingComma": "all",
				"useTabs": true
			}
		}
	],
	"plugins": ["prettier-plugin-astro"],
	"printWidth": 80,
	"quoteProps": "as-needed",
	"semi": true,
	"singleQuote": true,
	"sortPackageJson": true,
	"tabWidth": 2,
	"trailingComma": "all",
	"useTabs": true
}
