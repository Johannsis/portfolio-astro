---
interface Props {
  currentYear: number;
}

const { currentYear } = Astro.props;
---

<footer class="site-footer text-primary-100">
  <div class="site-footer__inner">
    <p class="body-xs site-footer__credit">
      Designed with <span aria-hidden="true">💚</span> in <span class="text-primary-100 font-600">
        Next.js
      </span> and <span class="text-primary-100 font-600">Tailwind CSS</span>,
      deployed in GitHub Pages.
    </p>
    <p class="body-xs text-primary-80 site-footer__copy">
      © {currentYear} Johannes Hoersch
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 3rem;
    width: 100%;
    z-index: 10;
  }

  .site-footer__inner {
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
    border-top: 1px solid oklch(0.24 0.02 200 / 0.15);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 80rem;
    width: 100%;
  }

  .site-footer__credit {
    line-height: 1.625;
    font-weight: 400;
  }

  .site-footer__copy {
    line-height: 1.625;
    font-weight: 400;
  }

  @media (min-width: 1024px) {
    .site-footer__inner {
      padding-top: 3rem;
      padding-bottom: 3rem;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
