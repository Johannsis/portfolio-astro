---
interface Props {
	sectionName: string;
}

const { sectionName } = Astro.props;
---

<a
	class='nav-link text-primary-80'
	data-section-link={sectionName}
	href={`#${sectionName}`}
>
	<span class='nav-line'></span>
	{sectionName}
</a>

<style>
	.nav-link {
		display: flex;
		width: fit-content;
		align-items: center;
		gap: 1rem;
		transition: color 300ms;
	}

	.nav-link:hover {
		color: var(--color-primary-100);
	}

	.nav-line {
		display: block;
		width: 2rem;
		height: 1px;
		background-color: var(--color-primary-80);
		transition:
			background-color 300ms,
			width 300ms;
	}

	.nav-link:hover .nav-line {
		width: 4rem;
		background-color: var(--color-primary-100);
	}
</style>
