---
interface Props {
	currentYear: number;
}

const { currentYear } = Astro.props;
---

<footer class='text-primary-100 z-10 mt-12 max-w-7xl self-center'>
	<div
		class='border-secondary-100/15 mx-auto flex w-full max-w-7xl flex-col gap-3 border-t py-10 lg:flex-row lg:items-center lg:justify-between lg:py-12'
	>
		<p class='body-xs leading-relaxed font-normal'>
			Designed with <span aria-hidden='true'>💚</span> in <span
				class='text-primary-100 font-semibold'
			>
				Astro
			</span> and <span class='text-primary-100 font-semibold'>UnoCSS</span>,
			deployed in GitHub Pages.
		</p>
		<p class='body-xs text-primary-80 leading-relaxed font-normal'>
			© {currentYear} Johannes Hoersch
		</p>
	</div>
</footer>
