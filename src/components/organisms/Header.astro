---
import ContactLinks from '@jh/components/molecules/ContactLinks.astro';
import HeaderSections from '@jh/components/molecules/HeaderSections.astro';
import type { SocialLink } from '@jh/data/user';

interface Props {
	job: string;
	location: string;
	motto: string;
	name: string;
	pageSections: readonly string[];
	socialLinks: SocialLink[];
}

const { job, location, motto, name, pageSections, socialLinks } = Astro.props;
---

<header
	class='mb-20 flex min-h-60 flex-col gap-6 lg:fixed lg:mb-0 lg:max-h-dvh lg:min-h-[90dvh] lg:max-w-[33%] lg:justify-between 2xl:max-w-[calc(20%-0.75rem)]'
>
	<div class='flex w-full flex-col gap-4'>
		<h1
			class='titles-4xl [background-image:var(--title-radial-gradient)] bg-clip-text leading-tight font-extrabold tracking-tight text-transparent lg:leading-12'
		>
			{name}
		</h1>
		<p class='titles-xl text-primary-100 font-bold tracking-tight'>
			{job}
		</p>
		<p class='body-sm text-primary-80 font-medium'>
			Based in {location}
		</p>
		<p class='body-sm text-primary-80 mt-2 max-w-xs'>
			{motto}
		</p>
	</div>

	<HeaderSections pageSections={pageSections} />
	<ContactLinks socialLinks={socialLinks} />
</header>
