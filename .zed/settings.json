{
	"code_actions_on_format": {
		"source.fixAll": true
	},
	"ensure_final_newline_on_save": true,
	"format_on_save": "on",
	"formatter": [
		{
			"language_server": {
				"name": "oxfmt"
			}
		}
	],
	"language_servers": ["!eslint", "..."],
	"languages": {
		"Astro": {
			"code_actions_on_format": {
				"source.fixAll": true
			},
			"format_on_save": "on",
			"formatter": {
				"external": {
					"arguments": [
						"prettier",
						"--stdin-filepath",
						"{buffer_path}",
						"--config",
						".prettierrc.json"
					],
					"command": "bunx"
				}
			},
			"language_servers": ["eslint", "..."],
			"prettier": { "allowed": true }
		}
	},
	"lsp": {
		"oxfmt": {
			"initialization_options": {
				"settings": {
					"fmt.configPath": ".oxfmtrc.json",
					"run": "onSave"
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": ".oxlintrc.json",
					"disableNestedConfig": false,
					"fixKind": "all",
					"run": "onType"
				}
			}
		},
		"stylelint-lsp": {
			"settings": {
				"stylelint": {
					"configFile": ".stylelintrc.json",
					"packageManager": "bun",
					"validate": ["css", "astro"]
				}
			}
		}
	}
}
