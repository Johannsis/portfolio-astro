---
interface Props {
	currentYear: number;
}

const { currentYear } = Astro.props;
---

<footer class='text-primary-100 mt-12 w-full z-10'>
	<div
		class='py-10 border-t border-secondary-100/15 flex flex-col gap-3 max-w-7xl w-full lg:py-12 lg:flex-row lg:items-center lg:justify-between'
	>
		<p class='body-xs leading-relaxed font-400'>
			Designed with <span aria-hidden='true'>💚</span> in <span
				class='text-primary-100 font-600'
			>
				Next.js
			</span> and <span class='text-primary-100 font-600'>Tailwind CSS</span>,
			deployed in GitHub Pages.
		</p>
		<p class='body-xs text-primary-80 leading-relaxed font-400'>
			© {currentYear} Johannes Hoersch
		</p>
	</div>
</footer>
