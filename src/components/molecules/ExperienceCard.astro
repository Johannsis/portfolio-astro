---
import type { ExperienceEntry } from '../../data/user';
import TechTag from './TechTag.astro';

type Props = ExperienceEntry;

const { companyName, description, period, position, stack, url } = Astro.props;
---

<article
	class='experience-card p-4 border border-transparent rounded-2xl flex grow flex-col gap-3 transition-all duration-500 ease-out lg:p-6 md:flex-row md:gap-12'
	data-experience-card
>
	<div class='pt-1 flex shrink-0 max-w-20'>
		<span class='body-xs text-primary-80 tracking-wide font-500 uppercase'>
			{period}
		</span>
	</div>

	<div class='flex flex-col gap-3'>
		<a
			aria-label={`${position} · ${companyName}`}
			class='flex'
			href={url}
			referrerpolicy='no-referrer'
			rel='noopener noreferrer'
			target='_blank'
		>
			<h3
				class='experience-title body-md leading-tight font-700 transition-colors duration-300 ease-in-out'
			>
				{position} · <span class='text-primary-100'>{companyName}</span>
			</h3>
		</a>

		<p class='body-xs text-primary-80 leading-relaxed font-400'>
			{description}
		</p>

		<ul class='flex flex-row flex-wrap gap-2'>
			{stack.map((tag) => <TechTag tag={tag} />)}
		</ul>
	</div>
</article>
