{
	"lsp": {
		"stylelint-lsp": {
			"settings": {
				"stylelint": {
					"configFile": ".stylelintrc.json",
					"packageManager": "bun",
					"validate": ["css", "astro"]
				}
			}
		},
		"oxlint": {
			"initialization_options": {
				"settings": {
					"configPath": "oxlint.config.ts",
					"run": "onType",
					"disableNestedConfig": false,
					"fixKind": "all"
				}
			}
		}
	},
	"code_actions_on_format": {
		"source.fixAll": true,
	},
	"format_on_save": "on",
	"prettier": {
		"allowed": false
	},
	"formatter": [
		{
			"language_server": {
				"name": "oxlint"
			}
		}
	],
	"ensure_final_newline_on_save": true,
	"language_servers": ["..."]
}
