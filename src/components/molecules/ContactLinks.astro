---
import type { SocialLink } from '../../data/user';
import ContactLink from './ContactLink.astro';

interface Props {
	socialLinks: SocialLink[];
}

const { socialLinks } = Astro.props;
---

<nav
	aria-label='Contact links'
	class='flex flex-row gap-5 h-fit lg:mb-36 lg:relative'
>
	{
		socialLinks.map(({ ariaLabel, icon, url }) => (
			<ContactLink ariaLabel={ariaLabel} icon={icon} url={url} />
		))
	}
</nav>
