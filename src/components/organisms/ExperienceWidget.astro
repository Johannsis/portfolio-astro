---
import type { ExperienceEntry } from '../../data/user';
import Icon from '../atoms/Icon.astro';
import Section from '../atoms/Section.astro';
import SectionTitle from '../atoms/SectionTitle.astro';
import ExperienceCard from '../molecules/ExperienceCard.astro';

interface Props {
	experience: ExperienceEntry[];
}

const { experience } = Astro.props;
---

<Section ariaLabel='Work experience' id='experience'>
	<SectionTitle title='experience' />

	<div
		class='experience-list flex grow flex-col gap-8 transition-all duration-500 ease-out'
	>
		{experience.map((entry) => <ExperienceCard {...entry} />)}
	</div>

	<a
		aria-label='View Full Resume (opens PDF in new tab)'
		class='text-primary-80 font-600 mt-4 flex gap-2 transition-colors duration-200 ease-in-out items-center hover:text-primary-100 lg:p-4'
		href='/assets/Johannes-Hoersch-CV.pdf'
		rel='noopener noreferrer'
		target='_blank'
	>
		<span class='body-md font-500'>View Full Resume</span>
		<Icon name='arrowRight' />
	</a>
</Section>
