---
// oxlint-disable unicorn/prefer-module
import type { IconNames } from './constants/iconNames';
import svgs from './svgs';

interface Props {
	'aria-hidden'?: boolean;
	className?: string;
	height?: number | string;
	iconName: IconNames;
	size?: number;
	stroke?: string;
	viewBox?: string;
	width?: number | string;
}

const {
	'aria-hidden': ariaHidden,
	className,
	height,
	iconName,
	size,
	stroke,
	viewBox,
	width,
} = Astro.props;

const heightValue = size || height;
const widthValue = size || width;
const Icon = svgs[iconName];

if (!Icon) return null;

const iconModule = await Icon();

if (!iconModule || !iconModule.default) return null;

const IconComponent = iconModule.default;

if (!IconComponent) return null;
---

<span aria-hidden={ariaHidden} class='relative flex'>
	<IconComponent
		className={className}
		height={heightValue}
		stroke={stroke}
		viewBox={viewBox}
		width={widthValue}
	/>
</span>
