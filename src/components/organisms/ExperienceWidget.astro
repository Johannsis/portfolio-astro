---
import Section from '@jh/components/atoms/Section.astro';
import SectionTitle from '@jh/components/atoms/SectionTitle.astro';
import ExperienceCard from '@jh/components/molecules/ExperienceCard.astro';
import { userData } from '@jh/data/user';
import Icon from '@jh/icons/index.astro';

const { experience } = userData;
---

<Section ariaLabel='Work experience' id='experience'>
	<SectionTitle title='experience' />
	<div
		class='group/list flex grow flex-col gap-8 transition-all duration-500 ease-out'
	>
		{experience.map((entry) => <ExperienceCard {...entry} />)}
	</div>
	<a
		aria-label='View Full Resume (opens PDF in new tab)'
		class='text-primary-80 hover:text-primary-100 mt-4 flex items-center gap-2 fill-current font-semibold transition-colors duration-200 ease-in-out lg:p-4'
		href='/assets/Johannes-Hoersch-CV.pdf'
		rel='noopener noreferrer'
		target='_blank'
	>
		<span class='body-md font-medium'>View Full Resume</span>
		<Icon
			aria-hidden
			className='fill-current'
			iconName='arrowRight'
			size={20}
		/>
	</a>
</Section>
