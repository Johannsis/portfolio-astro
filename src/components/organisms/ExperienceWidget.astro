---
import Icon from '@jh/components/atoms/Icon.astro';
import Section from '@jh/components/atoms/Section.astro';
import SectionTitle from '@jh/components/atoms/SectionTitle.astro';
import ExperienceCard from '@jh/components/molecules/ExperienceCard.astro';
import type { ExperienceEntry } from '@jh/data/user';

interface Props {
	experience: ExperienceEntry[];
}

const { experience } = Astro.props;
---

<Section ariaLabel='Work experience' id='experience'>
	<SectionTitle title='experience' />
	<div class='experience-list'>
		{experience.map((entry) => <ExperienceCard {...entry} />)}
	</div>
	<a
		aria-label='View Full Resume (opens PDF in new tab)'
		class='resume-link text-primary-80)'
		href='/assets/Johannes-Hoersch-CV.pdf'
		rel='noopener noreferrer'
		target='_blank'
	>
		<span class='body-md resume-link-label'>View Full Resume</span>
		<Icon name='arrowRight' />
	</a>
</Section>

<style>
	.experience-list {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		gap: 2rem;
		transition: all 500ms ease-out;
	}

	.resume-link {
		display: flex;
		align-items: center;
		margin-top: 1rem;
		font-weight: 600;
		gap: 0.5rem;
		transition: color 200ms ease-in-out;
	}

	.resume-link:hover {
		color: var(--color-primary-100);
	}

	.resume-link-label {
		font-weight: 500;
	}

	@media (width >= 1024px) {
		.resume-link {
			padding: 1rem;
		}
	}
</style>
