---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<h2 class="section-title titles-lg text-primary-100">
  {title}
</h2>

<style>
  .section-title {
    letter-spacing: 0.2em;
    font-weight: 700;
    padding-top: 1.5rem;
    padding-bottom: 1.5rem;
    width: 100%;
    text-transform: uppercase;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  @media (min-width: 1024px) {
    .section-title {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  }
</style>
