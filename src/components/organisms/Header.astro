---
import ContactLinks from '@jh/components/molecules/ContactLinks.astro';
import HeaderSections from '@jh/components/molecules/HeaderSections.astro';
import type { SocialLink } from '@jh/data/user';

interface Props {
	job: string;
	location: string;
	motto: string;
	name: string;
	pageSections: readonly string[];
	socialLinks: SocialLink[];
}

const { job, location, motto, name, pageSections, socialLinks } = Astro.props;
---

<header class='site-header'>
	<div class='site-header__top'>
		<h1 class='title-gradient titles-4xl site-header__name'>{name}</h1>
		<p class='text-primary-100 titles-xl site-header__job'>{job}</p>
		<p class='body-sm text-primary-80 site-header__location'>
			Based in {location}
		</p>
		<p class='body-sm text-primary-80 site-header__motto'>{motto}</p>
	</div>

	<HeaderSections pageSections={pageSections} />

	<ContactLinks socialLinks={socialLinks} />
</header>

<style>
	.site-header {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		min-height: 15rem;
		margin-bottom: 5rem;
	}

	.site-header__top {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		width: 100%;
	}

	.site-header__name {
		line-height: 1.25;
		letter-spacing: -0.025em;
		font-weight: 800;
	}

	.site-header__job {
		letter-spacing: -0.025em;
		font-weight: 700;
	}

	.site-header__location {
		font-weight: 500;
	}

	.site-header__motto {
		margin-top: 0.5rem;
		max-width: 20rem;
	}

	@media (min-width: 1024px) {
		.site-header {
			margin-bottom: 0;
			max-width: 33%;
			min-height: 90dvh;
			justify-content: space-between;
			position: fixed;
			max-height: 100dvh;
		}

		.site-header__name {
			line-height: 3rem;
		}
	}

	@media (min-width: 1536px) {
		.site-header {
			max-width: calc(20% - 0.75rem);
		}
	}
</style>
