---
import Icon from '@jh/components/atoms/Icon.astro';

interface Props {
	ariaLabel: string;
	icon: 'github' | 'linkedin' | 'mail';
	url: string;
}

const { ariaLabel, icon, url } = Astro.props;
const target = url.startsWith('mailto:')
	? null
	: '_blank';
---

<a
  aria-label={ariaLabel}
  class="contact-link text-primary-80"
  href={url}
  referrerpolicy="no-referrer"
  rel="noopener noreferrer"
  target={target}
>
  <Icon name={icon} />
</a>

<style>
  .contact-link {
    display: inline-flex;
    transition:
      color 300ms ease-out,
      transform 300ms ease-out;
  }

  .contact-link:hover {
    color: var(--color-primary-100);
    transform: scale(1.1);
  }
</style>
