---
interface Props {
	tag: string;
}

const { tag } = Astro.props;
---

<li class="tech-tag body-2xs text-primary-20">
  {tag}
</li>

<style>
  .tech-tag {
    padding: 0.25rem 0.75rem;
    border: 1px solid oklch(0.24 0.02 200deg / 60%);
    border-radius: 9999px;
    background-color: var(--color-primary-80);
    transition: all 300ms;
  }
</style>
