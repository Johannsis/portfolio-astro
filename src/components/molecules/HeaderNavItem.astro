---
interface Props {
	sectionName: string;
}

const { sectionName } = Astro.props;
---

<a
	class='group text-primary-80 hover:text-primary-100 flex w-fit flex-row items-center gap-4 transition-colors duration-300'
	data-section-link={sectionName}
	href={`#${sectionName}`}
>
	<span
		class='bg-primary-80 group-hover:bg-primary-100 h-px w-8 transition-all duration-300 ease-in-out group-hover:w-16'
	></span>
	{sectionName}
</a>
