---
import type { ExperienceEntry } from "@jh/data/user";

import TechTag from "./TechTag.astro";

type Props = ExperienceEntry;

const { companyName, description, period, position, stack, url } = Astro.props;
---

<article class="experience-card" data-experience-card>
  <div class="experience-card__period">
    <span class="body-xs text-primary-80 experience-card__period-text">
      {period}
    </span>
  </div>

  <div class="experience-card__content">
    <a
      aria-label={`${position} · ${companyName}`}
      class="experience-card__link"
      href={url}
      referrerpolicy="no-referrer"
      rel="noopener noreferrer"
      target="_blank"
    >
      <h3 class="experience-title body-md">
        {position} · <span class="text-primary-100">{companyName}</span>
      </h3>
    </a>

    <p class="body-xs text-primary-80 experience-card__desc">
      {description}
    </p>

    <ul class="experience-card__stack">
      {stack.map((tag) => <TechTag tag={tag} />)}
    </ul>
  </div>
</article>

<style>
  .experience-card {
    padding: 1rem;
    border: 1px solid transparent;
    border-radius: 1rem;
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 500ms ease-out;
  }

  .experience-card__period {
    padding-top: 0.25rem;
    display: flex;
    flex-shrink: 0;
    max-width: 5rem;
  }

  .experience-card__period-text {
    letter-spacing: 0.05em;
    font-weight: 500;
    text-transform: uppercase;
  }

  .experience-card__content {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .experience-card__link {
    display: flex;
  }

  .experience-title {
    line-height: 1.25;
    font-weight: 700;
    transition: color 300ms ease-in-out;
  }

  .experience-card__desc {
    line-height: 1.625;
    font-weight: 400;
  }

  .experience-card__stack {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .experience-card {
      flex-direction: row;
      gap: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .experience-card {
      padding: 1.5rem;
    }
  }
</style>
