{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": true,
	"mcp": {
		"Astro docs": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.docs.astro.build/mcp"
		},
		"chrome-devtools": {
			"command": ["npx", "-y", "chrome-devtools-mcp@latest"],
			"enabled": true,
			"type": "local"
		},
		"context7": {
			"enabled": true,
			"type": "remote",
			"url": "https://mcp.context7.com/mcp"
		},
		"playwright": {
			"command": ["npx", "@playwright/mcp@latest"],
			"enabled": true,
			"type": "local"
		}
	},
	"permission": {
		"*": "allow",
		"bash": {
			"*": "allow",
			"brew install *": "ask",
			"brew upgrade *": "ask",
			"chmod *": "ask",
			"chown *": "ask",
			"cp *": "ask",
			"curl *": "ask",
			"dd *": "ask",
			"docker *": "ask",
			"fdisk *": "ask",
			"format *": "ask",
			"git branch -D *": "ask",
			"git branch -d *": "ask",
			"git clean *": "ask",
			"git push": "ask",
			"git rebase *": "ask",
			"git reset --hard *": "ask",
			"kill *": "ask",
			"killall *": "ask",
			"mkdir *": "ask",
			"mkfs *": "ask",
			"mv *": "ask",
			"npm install *": "ask",
			"npm run publish": "ask",
			"parted *": "ask",
			"pip install *": "ask",
			"reboot": "ask",
			"rm *": "ask",
			"rsync *": "ask",
			"scp *": "ask",
			"shutdown": "ask",
			"ssh *": "ask",
			"sudo *": "ask",
			"touch *": "ask",
			"wget *": "ask"
		},
		"doom_loop": "ask",
		"external_directory": "ask"
	},
	"plugin": [
		"@franlol/opencode-md-table-formatter@0.0.3",
		"@mohak34/opencode-notifier@latest"
	]
}
